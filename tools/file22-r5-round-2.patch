@@ -277,17 +277,39 @@
 		if ( $submission instanceof WP_Error || ! Contract_Boundary::code( $error_code ) ) {
 			return false;
 		}
+		if ( in_array( (string) $submission['state'], array( 'resolved', 'failed', 'dead_letter' ), true ) ) {
+			return false;
