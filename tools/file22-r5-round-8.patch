+	public static function cleanup_expired(): int {
+		global $wpdb;
+		if ( ! is_object( $wpdb ) || ! method_exists( $wpdb, 'query' ) || ! method_exists( $wpdb, 'prepare' ) || ! self::tables_exist() ) {
+			return 0;
+		}
+		$deleted = 0;
+		$completed_cutoff = gmdate( 'Y-m-d H:i:s', time() - self::COMPLETED_OUTBOX_TTL );
+		$terminal_cutoff  = gmdate( 'Y-m-d H:i:s', time() - self::TERMINAL_RECORD_TTL );
+
+		$outbox_completed = $wpdb->query(
+			$wpdb->prepare(
+				"DELETE FROM %i WHERE status = 'completed' AND processed_at IS NOT NULL AND processed_at < %s LIMIT 500",
+				self::outbox_table_name(),
+				$completed_cutoff
+			)
+		);
+		$deleted += is_int( $outbox_completed ) && $outbox_completed > 0 ? $outbox_completed : 0;
+
+		$outbox_dead = $wpdb->query(
+			$wpdb->prepare(
+				"DELETE FROM %i WHERE status = 'dead_letter' AND updated_at < %s LIMIT 500",
+				self::outbox_table_name(),
+				$terminal_cutoff
+			)
+		);
+		$deleted += is_int( $outbox_dead ) && $outbox_dead > 0 ? $outbox_dead : 0;
+
+		$submissions = $wpdb->query(
+			$wpdb->prepare(
+				"DELETE FROM %i WHERE ((state IN ('resolved','failed') AND completed_at IS NOT NULL AND completed_at < %s) OR (state IN ('prepared','retryable','dead_letter') AND updated_at < %s)) AND attempt_uuid NOT IN (SELECT attempt_uuid FROM %i WHERE status IN ('queued','retry','processing','dead_letter')) LIMIT 500",
+				self::submission_table_name(),
+				$terminal_cutoff,
+				$terminal_cutoff,
+				self::outbox_table_name()
+			)
+		);
+		$deleted += is_int( $submissions ) && $submissions > 0 ? $submissions : 0;
+
+		return $deleted;
+	}
+
