{
  "name": "sabri-homeopathy/sabri-universal-post-composer",
  "description": "File 22 adapter-driven creation gateway for WordPress.",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "find . -type f -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
    "test": "phpunit --configuration=phpunit.xml.dist"
  }
}
